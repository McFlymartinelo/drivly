DRIVLY_PORT=80
# Exemple : 8080 si le port 80 est déjà pris par un autre service

# Jeton de la sauvegarde serveur (obligatoire).
# Génère-le avec : openssl rand -hex 32
DRIVLY_TOKEN=

# Secret des comptes (optionnel). 32 caractères minimum.
# Sans lui, le serveur reste en mode jeton uniquement.
# Génère-le avec : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Nombre de sauvegardes conservées côté serveur.
DRIVLY_MAX_SNAPSHOTS=50
